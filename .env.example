# Supabase project (Settings → API). The secret key is server-only; never prefix it with NEXT_PUBLIC.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Owner account: on the first Google sign-in this email becomes owner of a new workspace
# (no-op once an owner exists). Seed scripts also use it to find the workspace.
OWNER_EMAIL=
OWNER_WORKSPACE_NAME=Rimbaloka Trip
